# Supabase cloud sync (Phase 2). Copy to .env.local for local dev, and set the
# same two vars in Vercel → Project → Settings → Environment Variables.
# Both are SAFE to expose in the browser (that's what NEXT_PUBLIC_ means); the
# app enforces access via Supabase Row Level Security. Never put the service_role
# key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
